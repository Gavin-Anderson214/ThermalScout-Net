# Python temporary files and environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*
.vscode/
.idea/

# Raw or derived BIRDSAI imagery: large and may be subject to dataset terms
**/TrainReal/
**/TestReal/
**/conservation_drones_train_real/
**/conservation_drones_test_real/
**/birdsai_step2_output/
**/yolo_real/
data/**
!data/.gitkeep
*.zip
*.crdownload

# Model outputs can be large: store locally, not in Git history
training_runs/**
!training_runs/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.weights

# Local preview of a dataset frame: check dataset redistribution terms
examples/BIRDSAI_annotated_example.png

# Generated figures are reproducible from records
report/figures/real_training_loss.png
report/figures/model_comparison.png

# Local cached predictions and BIRDSAI-derived diagnostic images
records/experiments/*/predictions.json
records/experiments/*/validation_examples.png
records/experiments/*/human_examples.png

# Portable releases
dist/
!data/README.md
!training_runs/README.md
